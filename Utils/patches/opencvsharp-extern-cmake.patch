+# Eigen3 is referenced by OpenCV's INTERFACE_LINK_LIBRARIES. Ensure the imported
+# target exists: find_package(Eigen3) may resolve via MODULE mode (CMake's
+# bundled FindEigen3.cmake), which does NOT define the Eigen3::Eigen target.
+find_package(Eigen3 QUIET)
+# Always provide the Eigen3::Eigen target: OpenCV's exported config references it
+# in INTERFACE_LINK_LIBRARIES when OpenCV was built with Eigen, and the extern
+# only links against it (no direct Eigen includes), so an empty interface target
+# is sufficient when Eigen is not installed (e.g. CI runners).
+if(NOT TARGET Eigen3::Eigen)
+  add_library(Eigen3::Eigen INTERFACE IMPORTED)
+  if(EIGEN3_INCLUDE_DIRS)
+    target_include_directories(Eigen3::Eigen INTERFACE ${EIGEN3_INCLUDE_DIRS})
+  elseif(EIGEN3_INCLUDE_DIR)
+    target_include_directories(Eigen3::Eigen INTERFACE ${EIGEN3_INCLUDE_DIR})
   endif()
 endif()
 
+find_package(OpenCV REQUIRED)
+
 if(OpenCV_FOUND)
 	include_directories(${OpenCV_INCLUDE_DIRS})
 	#set(LIBS ${LIBS} ${OpenCV_LIBRARIES})
@@ -37,9 +46,23 @@ if(OpenCV_FOUND)
 	if(EMSCRIPTEN)
